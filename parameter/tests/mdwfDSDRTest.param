#
# mdwfDSDRTest.param
#
# DSDR determinant ratio and plaquette + rectangle gauge action (main_mdwfDSDRTest.cpp).
#
#        Lattice: Nx Ny Nz Nt (mode = gpt: the size of Gaugefile)
#          Nodes: single rank only
#           mode: unit = unit tests on a configuration generated from the unit start,
#                 gpt  = numbers for the cross-check with GPT (gpt_dsdr_check.py) on Gaugefile
#             M5: domain-wall height; the DSDR operators are D_W(-M5) + i eps gamma5
#    dsdr_twists: eps_0 < eps_1 < ... (factors eps_i / eps_(i+1); GPT tm_ratios 0.02:0.07,0.07:0.18,0.18:0.5)
# antiperiodic_t: fermion BCs in time (1 = antiperiodic, GPT boundary_phases [1,1,1,-1])
#       gauge_c1: rectangle coefficient (Iwasaki -0.331), c0 = 1 - 8 c1
#           beta: mode = gpt only (gauge action and force numbers)
#      precision: CG relative residual
#    source_site: mode = gpt: even site of the point sources (default 0 0 0 0)
#      Gaugefile: mode = gpt: NERSC configuration
#
Lattice        = 8 8 8 8
Nodes          = 1 1 1 1
mode           = unit
M5             = 1.8
dsdr_twists    = 0.02 0.07 0.18 0.5
antiperiodic_t = 1
gauge_c1       = -0.331
precision      = 1e-12
max_iter       = 100000
