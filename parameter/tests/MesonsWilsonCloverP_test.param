#
# configConverter.param
#
#      Lattice: Nx Ny Nz Nt
#        Nodes: Number of nodes per direction
#    Gaugefile: Name of input gauge configuration
#   endianness: Endianness of input configuration
#       format: Format of input configuration (ildg, milc, or nersc)
#   format_out: Format of output configuration (ildg or nersc)
#     prec_out: Precision of the output configuration, 1 for single and 2 for double
#
Lattice       = 20 20 20 20
Nodes         = 1 2 1 1
beta          = 3.360
gauge_file    = l20t20b06498a_nersc.302500
gauge_file_folder = ./
format        = nersc
endianness    = auto
mass          = 4.071
mass2         = 4.071
csw           = 1.0286
sourcePos     = 0 0 0 0
sources       = 1 1 1 1
smear1         = 0.0
smearSteps1    = 0
smear2         = 0.0
smearSteps2    = 0
tolerance      = 1e-20
maxiter        = 10000
use_hyp        = 0
use_mass2      = 0

use_wilson=0
wilson_step=0.001
wilson_start=0.0
wilson_stop=0.125

nP=5
measure_I=1
measure_g5=1
measure_gi=1
measure_gig5=1
measure_g4=1
measure_gig4=1

