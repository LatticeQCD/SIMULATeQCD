#
# mdwfFifthDimTest.param -- lattice of the MDWF tests whose physics parameters are built in
# (most mdwf*Test programs read this file by default; the name is historical)
#
#    Lattice: Nx Ny Nz Nt
#      Nodes: ranks per direction (the tests run on one rank)
#
Lattice    = 6  6  6  6
Nodes      = 1  1  1  1
